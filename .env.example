# ── ZypherCenter — Environment Variables ──────────────────────────────────────
# For deployment:  copy to .env, fill in PROXMOX_HOST and SESSION_SECRET
# For development: copy to .env, adjust CORS_ORIGIN to match your dev port
# ─────────────────────────────────────────────────────────────────────────────

# ─── Proxmox Connection ───────────────────────────────────────────────────────
# Full URL to your Proxmox host (include port 8006).
# For mesh networks, use the internal IP (e.g., https://10.x.x.x:8006).
PROXMOX_HOST=https://YOUR_PROXMOX_IP:8006

# Set to "false" to accept self-signed certificates (common in home labs).
PROXMOX_TLS_VERIFY=false

# ─── Session Security ─────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
# This secret signs the session cookies; keep it private.
SESSION_SECRET=

# Set to "true" only if serving ZypherCenter over HTTPS via Zoraxy or Nginx.
COOKIE_SECURE=false

# ─── API Server ───────────────────────────────────────────────────────────────
API_PORT=3001

# Origin(s) allowed to call the API directly.
# In Docker production (single-container), this should match the public URL.
CORS_ORIGIN=http://localhost

# ─── Logging & Environment ───────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production

# ─── Deployment Image (docker-compose.yml) ────────────────────────────────────
# These apply when using the deployment-ready docker-compose.yml.
HTTP_PORT=80
IMAGE_REGISTRY=codevault.sh/zypher-systems
IMAGE_TAG=v0.7.0
